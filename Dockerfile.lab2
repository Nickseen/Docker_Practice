# Dockerfile for Lab 2 - HTTP File Server with Thread Pool
FROM python:3.9-slim

# Set working directory
WORKDIR /app

# Copy server file
COPY file_server_lab2.py .

# Copy content directory
COPY content/ /app/content/

# Expose port 8080
EXPOSE 8080

# Environment variables with defaults
ENV NUM_THREADS=4
ENV WORK_DELAY=1

# Run the server with thread pool
# Build the command dynamically based on environment variables
CMD python file_server_lab2.py content/ --threads ${NUM_THREADS} --delay ${WORK_DELAY}
